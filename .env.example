--- APP CONFIGURATION ---

EXTERNAL_BASE_URL=https://your-public-url.trycloudflare.com
SLACK_INTERACTIVE_ENDPOINT=/api/v1/slack/interactive
TIMEZONE=your-timezone

--- JIRA INTEGRATION ---

JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_DOMAIN_URL=https://your-domain.jira.com/

--- QDRANT VECTOR DB ---

QDRANT_ENDPOINT_URL=https://your-qdrant-instance.qdrant.io:6333
QDRANT_API_TOKEN=
QDRANT_COLLECTION_JIRA=jira_issues
QDRANT_COLLECTION_NOTIFIED=issue_notified_check
QDRANT_COLLECTION_JOBS=cron_jobs
QDRANT_VECTOR_SIZE=1024

--- SLACK INTEGRATION ---

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_ID=C0123456789

--- OLLAMA LOCAL EMBEDDINGS ---

OLLAMA_BASE_URL=http://ollama:11434/api/embeddings
OLLAMA_EMBEDDING_MODEL=bge-m3:567m

--- LARGE LANGUAGE MODELS ---

LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_API_KEY=

--- GOOGLE SHEET DASHBOARD ---

GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=